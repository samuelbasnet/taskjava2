public class HarshadChecker {
    public static boolean isHarshadNumber(int n) {
        int sum = 0;
        int temp = n;

        while (temp > 0) {
            sum += temp % 10;
            temp /= 10;
        }

        return n % sum == 0;
    }

    public static void main(String[] args) {
        int number = 18;
        System.out.println(number + " is Harshad number: " + isHarshadNumber(number));
    }
}
